# ── RUNTIME (the application process) ──────────────────────────────────────────
# Only these keys may be present in the application's runtime environment.
# Settings() refuses to start if any key from the non-runtime section below is present.
BAAKI_APP_DSN=<POSTGRES_DSN_FOR_BAAKI_APP>
BAAKI_AGENT_DSN=<POSTGRES_DSN_FOR_BAAKI_AGENT>
BAAKI_SIM_DSN=<POSTGRES_DSN_FOR_BAAKI_SIM>
RAZORPAY_KEY_ID=<RZP_TEST_KEY_ID>

# ── NON-RUNTIME: bootstrap / migration / operator only ─────────────────────────
# These credentials are injected only into the migration step (make migrate / CI),
# the one-time bootstrap (make bootstrap), or an operator's shell. NEVER into the app.
# BAAKI_SUPERUSER_DSN=<SUPERUSER_DSN_FOR_BOOTSTRAP_ONLY>
# BAAKI_MIGRATE_DSN=<POSTGRES_DSN_FOR_BAAKI_MIGRATE>
# BAAKI_OPS_DSN=<POSTGRES_DSN_FOR_BAAKI_OPS>
# BAAKI_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET_FOR_BOOTSTRAP_SECRETS_SQL>

# ── AGENT LEG ONLY (baaki_agent; Phase 2b-3/2b-4) ──────────────────────────────────────────────
# Deliberately NOT in the RUNTIME section above: the pipeline leg must never hold this key.
# `take_model_credential()` reads it into a SecretStr and REMOVES it from the environment before the
# baaki_app leg is created; `assert_no_model_credential()` refuses to run the pipeline if it is still
# reachable. Absence is not an error — the workflow degrades to the deterministic rules path.
OPENAI_API_KEY=
